{
  "name": "os",
  "version": "26.08.24",
  "type": "module",
  "description": "a hypertext based generative Operating System",
  "main": "index.js",
  "scripts": {
    "start": "npm run build && node --env-file=.env servers/local.js",
    "build": "npm run build:llms && vite build ",
    "build:github": "npm run build:llms && GITHUB_PAGES=true node servers/github.js && GITHUB_PAGES=true vite build",
    "build:llms": "node scripts/copy-src.js && node scripts/build-llms.js"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "html-minifier-terser": "^7.2.0",
    "qrcode": "^1.5.4",
    "tree-cli": "^0.6.7",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
