<script>
// all later scripts communicate ONLY through window.chatEvents and never touch the DOM directly
window.chatEvents = (function() {
  var handlers = {};
  var on = function(name, fn) {
    if (!handlers[name]) handlers[name] = [];
    handlers[name].push(fn);
  };
  var emit = function(name, payload) {
    var list = handlers[name];
    if (list) {
      for (var i = 0; i < list.length; i++) {
        try {
          list[i](payload);
        } catch (e) {
          console.error('Error in handler for', name, e);
        }
      }
    }
  };
  var eventNames = ['user','delta','assistant','tool_call','tool_result','compact','plan','status','error','done'];
  for (var i = 0; i < eventNames.length; i++) {
    (function(evt) {
      on(evt, function(payload) {
        console.log(evt, payload);
      });
    })(eventNames[i]);
  }
  return { on: on, emit: emit };
})();
</script>

<script>
var streamDiv = null;

function nearBottom() {
  var el = document.getElementById('chat-messages');
  return el.scrollTop + el.clientHeight >= el.scrollHeight - 40;
}

function appendMsg(cssClass, text) {
  var el = document.getElementById('chat-messages');
  var wasNearBottom = nearBottom();
  var div = document.createElement('div');
  div.className = 'msg ' + cssClass;
  div.appendChild(document.createTextNode(text));
  el.appendChild(div);
  if (wasNearBottom) {
    el.scrollTop = el.scrollHeight;
  }
  return div;
}

window.chatEvents.on('user', function(payload) {
  appendMsg('user', payload);
});

window.chatEvents.on('delta', function(payload) {
  if (!streamDiv) {
    streamDiv = appendMsg('assistant', '');
  }
  streamDiv.appendChild(document.createTextNode(payload));
  if (nearBottom()) {
    var el = document.getElementById('chat-messages');
    el.scrollTop = el.scrollHeight;
  }
});

window.chatEvents.on('assistant', function(payload) {
  if (!streamDiv) {
    appendMsg('assistant', payload);
  }
  streamDiv = null;
});

window.chatEvents.on('tool_call', function(payload) {
  appendMsg('tool', 'tool call: ' + payload);
});

window.chatEvents.on('tool_result', function(payload) {
  appendMsg('tool', 'result: ' + payload);
});

window.chatEvents.on('compact', function(payload) {
  appendMsg('marker', '--- context compacted: ' + payload + ' ---');
});

window.chatEvents.on('plan', function(payload) {
  appendMsg('marker', 'plan: ' + payload);
});

window.chatEvents.on('error', function(payload) {
  appendMsg('error', String(payload));
});

window.chatEvents.on('status', function(payload) {
  document.getElementById('status-bar').innerText = String(payload);
});
</script>

<script>
window.fetchAI = async function(systemPrompt) {
  var model = document.getElementById('model-name').value;
  var host = document.getElementById('model-host').value;
  var apikey = document.getElementById('api-key').value;
  localStorage.setItem('m', model);
  localStorage.setItem('h', host);
  localStorage.setItem('k', apikey);
  var messages = [{ role: 'system', content: systemPrompt }].concat(window.chat);
  window.abortCtrl = new AbortController();
  var headers = { 'Content-Type': 'application/json' };
  if (apikey) {
    headers.Authorization = 'Bearer ' + apikey;
  }
  var body = JSON.stringify({ model: model, messages: messages, stream: true });
  var fullText = '';
  try {
    var response = await fetch(host, {
      method: 'POST',
      headers: headers,
      body: body,
      signal: window.abortCtrl.signal
    });
    if (!response.ok) {
      window.chatEvents.emit('error', 'HTTP ' + response.status);
      return '';
    }
    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    while (true) {
      var done = false;
      var value = await reader.read();
      done = value.done;
      if (done) break;
      buffer += decoder.decode(value.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop();
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (line.startsWith('data: ')) {
          var data = line.slice(6);
          if (data === '[DONE]') {
            done = true;
            break;
          }
          try {
            var json = JSON.parse(data);
            var content = json.choices && json.choices[0] && json.choices[0].delta && json.choices[0].delta.content;
            if (content) {
              fullText += content;
              window.chatEvents.emit('delta', content);
            }
          } catch (e) {
            // ignore parse errors
          }
        }
      }
      if (done) break;
    }
    return fullText;
  } catch (err) {
    if (err.name === 'AbortError') {
      window.chatEvents.emit('status', 'stopped');
    } else {
      window.chatEvents.emit('error', err.message);
    }
    return fullText;
  }
};

window.sendChat = async function(text) {
  window.chat.push({ role: 'user', content: text });
  window.chatEvents.emit('user', text);
  var systemFile = document.getElementById('system-file').value;
  var systemPrompt;
  if (systemFile) {
    var sf = await read(systemFile);
    if (sf) {
      systemPrompt = sf;
    } else {
      systemPrompt = localStorage.getItem('s') || 'You are a helpful assistant.';
    }
  } else {
    systemPrompt = localStorage.getItem('s') || 'You are a helpful assistant.';
  }
  window.chatEvents.emit('status', 'thinking...');
  var reply = await window.fetchAI(systemPrompt);
  window.chat.push({ role: 'assistant', content: reply });
  window.chatEvents.emit('assistant', reply);
  window.chatEvents.emit('status', 'idle');
  window.chatEvents.emit('done', reply);
};

document.getElementById('submit-btn').addEventListener('click', function() {
  var input = document.getElementById('user-input');
  var text = input.value.trim();
  if (text) {
    window.sendChat(text);
    input.value = '';
  }
});

document.getElementById('user-input').addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') {
    var input = document.getElementById('user-input');
    var text = input.value.trim();
    if (text) {
      window.sendChat(text);
      input.value = '';
    }
  }
});

document.getElementById('stop-btn').addEventListener('click', function() {
  window.stopAgent = true;
  if (window.abortCtrl) {
    window.abortCtrl.abort();
  }
});
</script>

<script>
function clean(raw) {
  var text = raw.trim();
  var tags = ['</ACTION>', '</ACTION>>', '</ANSWER>', '</ANSWER>>', '</tool_input>', '</invoke>', '</parameter>', '</tool_call>', '</function_calls>'];
  var changed = true;
  while (changed) {
    changed = false;
    for (var i = 0; i < tags.length; i++) {
      if (text.endsWith(tags[i])) {
        text = text.slice(0, text.length - tags[i].length).trim();
        changed = true;
        break;
      }
    }
  }
  return text;
}

window.parseAction = function(text) {
  var match = /<<ACTION:\s*([^>]+)>>\n([\s\S]*?)(?=<<|$)/.exec(text);
  if (match) {
    return { name: match[1].trim(), input: clean(match[2]) };
  }
  var invokeMatch = /<invoke name="([^"]+)">/.exec(text);
  if (!invokeMatch) {
    return null;
  }
  var rest = text.slice(invokeMatch.index + invokeMatch[0].length);
  var nextInvoke = /<invoke name="/.exec(rest);
  if (nextInvoke) {
    rest = rest.slice(0, nextInvoke.index);
  }
  var paramRegex = /<parameter name="[^"]+">([\s\S]*?)<\/parameter>/g;
  var param;
  var params = [];
  while ((param = paramRegex.exec(rest)) !== null) {
    params.push(param[1]);
  }
  var input;
  if (params.length === 0) {
    input = '';
  } else if (params.length === 1) {
    input = params[0];
  } else {
    input = params.join('\n');
  }
  return { name: invokeMatch[1].trim(), input: clean(input) };
};

window.parseAnswer = function(text) {
  var match = /<<ANSWER>>\n([\s\S]*?)(?=<<|$)/.exec(text);
  if (match) {
    return clean(match[1]);
  }
  return null;
};
</script>

<script>
window.buildAgentPrompt = async function() {
  var systemFile = document.getElementById('system-file').value;
  var base;
  if (systemFile) {
    base = await read(systemFile);
  }
  if (!base) {
    base = localStorage.getItem('s');
  }
  if (!base) {
    base = 'You are a helpful assistant.';
  }
  var prompt = base;
  prompt += '\n\nOUTPUT FORMAT rules, short and absolute: every single reply MUST end with exactly one of the two tags; to use a tool output <<ACTION: tool_name>> then the input on the next line; to finish output <<ANSWER>> then the final message on the next line; NEVER use XML or <tool_call> tags; NEVER narrate tool use in plain prose; the <<ACTION>> tag is the only way a tool runs; a reply with no tag is a format error';
  prompt += '\n\nEXAMPLE block showing one full well-formed finishing reply:\n<<ANSWER>>\nThis is an example sentence.';
  prompt += '\n\nAVAILABLE TOOLS: ';
  if (window.getActiveToolsString) {
    prompt += await window.getActiveToolsString();
  } else {
    prompt += 'NO TOOLS AVAILABLE, ANSWER DIRECTLY';
  }
  prompt += '\n\nCURRENT PLAN: ' + window.agentPlan;
  prompt += '\n\nWORKING MEMORY: ';
  var keys = Object.keys(window.agentScratchpad);
  if (keys.length === 0) {
    prompt += '[Empty]';
  } else {
    for (var i = 0; i < keys.length; i++) {
      var k = keys[i];
      prompt += '\nMEMORY POINTER: ' + k + ' = ' + window.agentScratchpad[k];
    }
  }
  return prompt;
};
</script>

<script>
window.runAgent = async function(userMessage) {
  window.chat.push({ role: 'user', content: userMessage });
  window.chatEvents.emit('user', userMessage);
  var errorCount = 0;
  var formatFails = 0;
  while (true) {
    try {
      var systemPrompt = await window.buildAgentPrompt();
      if (window.stopAgent) {
        systemPrompt += '\nUSER OVERRIDE: Stop executing tools. Output <<ANSWER>>.';
        window.stopAgent = false;
      }
      window.chatEvents.emit('status', 'thinking...');
      var aiResponse = await window.fetchAI(systemPrompt);
      window.chatEvents.emit('assistant', aiResponse);
      window.chat.push({ role: 'assistant', content: aiResponse });
      window.chatEvents.emit('status', 'idle');
      var action = window.parseAction(aiResponse);
      if (action && window.executeTool) {
        formatFails = 0;
        window.chatEvents.emit('tool_call', action.name);
        var result = await window.executeTool(action.name, action.input);
        window.chatEvents.emit('tool_result', result);
        window.chat.push({ role: 'user', content: 'OBSERVATION:\n' + result });
        continue;
      }
      if (action && !window.executeTool) {
        window.chat.push({ role: 'user', content: 'SYSTEM WARNING: no tool executor installed. Answer directly with <<ANSWER>>.' });
        continue;
      }
      var answer = window.parseAnswer(aiResponse);
      if (answer !== null) {
        window.chatEvents.emit('done', answer);
        break;
      }
      formatFails++;
      if (formatFails >= 3) {
        window.chatEvents.emit('error', 'model failed the output format 3 times');
        window.chatEvents.emit('done', aiResponse);
        break;
      }
      window.chat.push({ role: 'user', content: 'SYSTEM WARNING: format error. Your last reply had no usable tag. Reply again and end it one of two ways: <<ACTION: name>> then the tool input on the next line, or <<ANSWER>> then your message on the next line. Put nothing after the input or message.' });
    } catch (err) {
      errorCount++;
      window.chatEvents.emit('error', err.message);
      if (errorCount >= 7) {
        break;
      }
    }
  }
};

