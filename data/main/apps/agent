    </div>
  </div>
  <div id="chat-messages"></div>
  <div id="status-bar">idle</div>
  <div id="chat-footer">
    <textarea id="user-input"></textarea>
    <button id="submit-btn">Send</button>
    <button id="stop-btn">Stop</button>
  </div>
</div>

