    window.abortCtrl.abort();
  }
});
</script>

<script>
var toolPrefix = function() {
  var v = document.getElementById('tools-folder').value.trim();
  if (v && v[v.length - 1] !== '/') v += '/';
  return v;
};

window.getActiveToolsString = async function() {
  var prefix = toolPrefix();
  var lines = [];
  var matchedKeys = await keys(IDBKeyRange.bound(prefix, prefix + '\uffff'));
  for (var i = 0; i < matchedKeys.length; i++) {
    var c = await read(matchedKeys[i]);
    var desc = 'No description';
    if (c && c.includes('/*')) {
      desc = c.split('*/')[0].split('/*')[1].trim();
    }
    lines.push(matchedKeys[i].slice(prefix.length) + ' - ' + desc);
  }
  return lines.length ? lines.join('\n') : 'No tools found.';
};

window.executeTool = async function(toolName, toolInput) {
  try {
    var prefix = toolPrefix();
    var code = await read(toolName);
    if (!code && !toolName.startsWith(prefix)) {
      code = await read(prefix + toolName);
    }
    if (!code) {
      throw new Error('Tool not found: ' + toolName);
    }
    code = code.replace(/^\/\*[\s\S]*?\*\//, '').trim();
    return await new Function('INPUT', 'return (async () => {' + code + '})()')(toolInput);
  } catch (err) {
    console.error('Tool Execution Failed:', err);
    return 'Tool Execution Error: ' + err.message;
  }
};
</script>

<script>
// skills are the cheap context tier, only the one-line descriptions cost tokens every turn, bodies are loaded on demand through the read tool
if (window.buildAgentPrompt && window.buildAgentPrompt._hasSkills) {
  // already wrapped, do nothing
} else {
  var prevBuildSkills = window.buildAgentPrompt;
  
  var skillPrefix = function() {
    var v = document.getElementById('skills-folder').value.trim();
    if (v && v[v.length - 1] !== '/') v += '/';
    return v;
  };
  
  window.getSkillsIndex = async function() {
    var prefix = skillPrefix();
    var lines = [];
    var matchedKeys = await keys(IDBKeyRange.bound(prefix, prefix + '\uffff'));
    for (var i = 0; i < matchedKeys.length; i++) {
      var c = await read(matchedKeys[i]);
      var desc = 'No description';
      if (c && c.includes('/*')) {
        desc = c.split('*/')[0].split('/*')[1].trim();
      }
      lines.push(matchedKeys[i] + ' - ' + desc);
    }
    return lines.length ? lines.join('\n') : '';
  };
  
  window.buildAgentPrompt = async function() {
    var p = await prevBuildSkills();
    var idx = await window.getSkillsIndex();
    if (idx) {
      p += '\nSKILLS (load before use):\n' + idx + '\nTo apply a skill, first load its full body with the read tool, then follow its instructions.\n';
    }
    return p;
  };
  window.buildAgentPrompt._hasSkills = true;
}
</script>

<script>
// identity tier (soul/user) loaded first, eager context-files loaded last, [[links]] are pay-when-needed
if (window.buildAgentPrompt && !window.buildAgentPrompt._hasIdentity) {
  var prevBuildIdentity = window.buildAgentPrompt;
  window.buildAgentPrompt = async function() {
    // identity tier
    var identity = '';
    var soul = await read('soul');
    if (soul) identity += '<soul>' + soul + '</soul>';
    var user = await read('user');
    if (user) identity += '<user>' + user + '</user>';
    
    var p = await prevBuildIdentity();
    if (identity) p = identity + '\n\n' + p;
    
    // wikilink rule
    p += '\nWhen a message contains [[links]], treat each link as a file name in the dataverse and load it with the read tool before answering.';
    
    // eager context tier
    var cf = document.getElementById('context-files').value;
    if (cf) {
      var entries = cf.split(',');
      for (var i = 0; i < entries.length; i++) {
        var entry = entries[i].trim();
        if (!entry) continue;
        var c = await read(entry);
        if (c) p += '\n<context file="' + entry + '">\n' + c + '\n</context>';
      }
    }
    
    return p;
  };
  window.buildAgentPrompt._hasIdentity = true;
}
</script>


<script>
// Plan file management and heartbeat for agent
(function() {
  // Generate unique agent ID from crypto.getRandomValues
  var bytes = new Uint8Array(8);
  crypto.getRandomValues(bytes);
  window.agentId = '';
  for (var i = 0; i < bytes.length; i++) {
    window.agentId += bytes[i].toString(16).padStart(2, '0');
  }

  // Plan path: memory#agents/<agentId>/plan
  var planKey = 'agents/' + window.agentId + '/plan';
  var planPath = 'memory#' + planKey;

  // Helper to read plan file (namespace split: key and namespace are separate args)
  window.readPlan = async function() {
    return await read(planKey, 'memory');
  };

  // Helper to write plan file
  window.writePlan = async function(content) {
    await write(content, planKey, 'memory');
  };

  // Wrap buildAgentPrompt to append CURRENT PLAN section at the very end
  var prevBuildAgentPrompt = window.buildAgentPrompt;
  window.buildAgentPrompt = async function() {
    var prompt = await prevBuildAgentPrompt();

    // Read current plan contents (use 'empty' when file does not exist)
    var planContents = 'empty';
    try {
      var plan = await window.readPlan();
      if (plan) planContents = plan;
    } catch (e) {
      // file doesn't exist, keep 'empty'
    }

    // Read planning skill from skills namespace
    var planningSkill = '';
    try {
      planningSkill = await read('planning', 'skills');
    } catch (e) {
      planningSkill = 'No planning skill found.';
    }

    // Append CURRENT PLAN section as the last thing in the prompt
    prompt += '\nCURRENT PLAN\n';
    prompt += 'path: ' + planPath + '\n';
    prompt += 'contents: ' + planContents + '\n';
    prompt += 'how to plan: ' + planningSkill + '\n';

    return prompt;
  };
  window.buildAgentPrompt._hasPlan = true;

  // Heartbeat: wrap fetchAI to inject reminders at maximum recency
  var prevFetchAI = window.fetchAI;
  var beatSeen = 0;

  function countToolResults() {
    var count = 0;
    for (var i = 0; i < window.chat.length; i++) {
      var msg = window.chat[i];
      if (msg.role === 'user' && typeof msg.content === 'string' && msg.content.startsWith('OBSERVATION:')) {
        count++;
      }
    }
    return count;
  }

  function getNewestToolResult() {
    for (var i = window.chat.length - 1; i >= 0; i--) {
      var msg = window.chat[i];
      if (msg.role === 'user' && typeof msg.content === 'string' && msg.content.startsWith('OBSERVATION:')) {
        return msg.content;
      }
    }
    return null;
  }

  window.fetchAI = async function(systemPrompt) {
    var currentCount = countToolResults();
    var diff = currentCount - beatSeen;
    beatSeen = currentCount;

    var shouldRemind = false;
    if (diff >= 3) {
      shouldRemind = true;
    } else if (diff > 0) {
      var newest = getNewestToolResult();
      if (newest && newest.includes('Tool Execution Error:')) {
        shouldRemind = true;
      }
    }

    if (shouldRemind) {
      var reminder = { role: 'user', content: 'Reminder: check your plan file (path in the system prompt), update it to match reality, then continue' };
      window.chat.push(reminder);
      try {
        return await prevFetchAI(systemPrompt);
      } finally {
        var idx = window.chat.indexOf(reminder);
        if (idx !== -1) {
          window.chat.splice(idx, 1);
        }
      }
    }

    return prevFetchAI(systemPrompt);
  };
  window.fetchAI._hasHeartbeat = true;
})();
</script>