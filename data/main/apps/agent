<script>
var toolPrefix = function() {
  var v = document.getElementById('tools-folder').value.trim();
  if (v && v.charAt(v.length - 1) !== '/') v += '/';
  return v;
};

window.getActiveToolsString = async function() {
  var prefix = toolPrefix();
  var lines = [];
  var matchedKeys = await keys(IDBKeyRange.bound(prefix, prefix + '\uffff'));
  for (var i = 0; i < matchedKeys.length; i++) {
    var k = matchedKeys[i];
    var c = await read(k);
    var desc = 'No description';
    if (c && c.indexOf('/*') !== -1) {
      desc = c.split('*/')[0].split('/*')[1].trim();
    }
    lines.push(k.slice(prefix.length) + ' - ' + desc);
  }
  if (lines.length === 0) return 'No tools found.';
  return lines.join('\n');
};

window.executeTool = async function(toolName, toolInput) {
  try {
    var prefix = toolPrefix();
    var code = await read(toolName);
    if (!code && toolName.slice(0, prefix.length) !== prefix) {
      code = await read(prefix + toolName);
    }
    if (!code) throw new Error('Tool not found: ' + toolName);
    if (code.startsWith('/*')) {
      var endIdx = code.indexOf('*/');
      if (endIdx !== -1) {
        code = code.slice(endIdx + 2).trim();
      }
    }
    return await new Function('INPUT', 'return (async () => {' + code + '})()')(toolInput);
  } catch (err) {
    console.error('Tool Execution Failed:', err);
    return 'Tool Execution Error: ' + err.message;
  }
};
</script>

<script>
// skills are the cheap context tier, only the one-line descriptions cost tokens every turn, bodies are loaded on demand through the read tool
if (window.buildAgentPrompt && !window.buildAgentPrompt._hasSkills) {
  var prevBuildSkills = window.buildAgentPrompt;

  var skillPrefix = function() {
    var v = document.getElementById('skills-folder').value.trim();
    if (v && v.charAt(v.length - 1) !== '/') v += '/';
    return v;
  };

  window.getSkillsIndex = async function() {
    var prefix = skillPrefix();
    var lines = [];
    var matchedKeys = await keys(IDBKeyRange.bound(prefix, prefix + '\uffff'));
    for (var i = 0; i < matchedKeys.length; i++) {
      var c = await read(matchedKeys[i]);
      var desc = 'No description';
      if (c && c.indexOf('/*') !== -1) {
        desc = c.split('*/')[0].split('/*')[1].trim();
      }
      lines.push(matchedKeys[i] + ' - ' + desc);
    }
    return lines.length > 0 ? lines.join('\n') : '';
  };

  window.buildAgentPrompt = async function() {
    var p = await prevBuildSkills();
    var idx = await window.getSkillsIndex();
    if (idx) {
      p += '\nSKILLS (load before use):\n' + idx + '\nTo apply a skill, first load its full body with the read tool, then follow its instructions.\n';
    }
    return p;
  };
  window.buildAgentPrompt._hasSkills = true;
}
</script>

<script>
// identity tier: soul and user are short identity files, context-files is eager pay-now tier for large documents, [[links]] are pay-when-needed tier handled by the read tool
if (window.buildAgentPrompt && !window.buildAgentPrompt._hasIdentity) {
  var prevBuildIdentity = window.buildAgentPrompt;
  window.buildAgentPrompt = async function() {
    var soul = await read('soul');
    var user = await read('user');
    var identity = '';
    if (soul) identity += '<soul>\n' + soul + '\n</soul>';
    if (user) {
      if (identity) identity += '\n';
      identity += '<user>\n' + user + '\n</user>';
    }
    var p = await prevBuildIdentity();
    if (identity) p = identity + '\n\n' + p;
    p += '\nWhen a message contains [[links]], treat each link as a file name in the dataverse and load it with the read tool before answering.';
    var ctxInput = document.getElementById('context-files');
    if (ctxInput) {
      var ctxVal = ctxInput.value.trim();
      if (ctxVal) {
        var entries = ctxVal.split(',');
        for (var i = 0; i < entries.length; i++) {
          var entry = entries[i].trim();
          if (!entry) continue;
          var c = await read(entry);
          if (c) p += '\n<context file="' + entry + '">\n' + c + '\n</context>';
        }
      }
    }
    return p;
  };
  window.buildAgentPrompt._hasIdentity = true;
}
</script>

<script>
// chunked context compaction - CRITICAL: prevFetchCompact is unique to avoid infinite recursion
var prevFetchCompact = window.fetchAI;

if (window.fetchAI && !window.fetchAI._hasCompaction) {
  window.estimateTokens = function(text) {
    return Math.ceil(text.length / 4 * 1.2);
  };

  window.summarizeText = async function(text, instructions) {
    var model = document.getElementById('model-name').value;
    var host = document.getElementById('model-host').value;
    var apikey = document.getElementById('api-key').value;
    var headers = { 'Content-Type': 'application/json' };
    if (apikey) {
      headers.Authorization = 'Bearer ' + apikey;
    }
    var body = JSON.stringify({
      model: model,
      messages: [
        { role: 'system', content: instructions },
        { role: 'user', content: text }
      ],
      stream: false
    });
    var resp = await fetch(host, {
      method: 'POST',
      headers: headers,
      body: body
    });
    var json = await resp.json();
    return json.choices[0].message.content;
  };

  window.compactChat = async function() {
    try {
      var capacity = parseInt(document.getElementById('compact-threshold').value) || 500000;
      var maxChunk = Math.floor(capacity * 0.4);
      var tailTokens = Math.floor(capacity * 0.1);

      // walk backwards to collect tail
      var tail = [];
      var tailCount = 0;
      var i = window.chat.length - 1;
      while (i >= 0 && tailCount < 2) {
        tail.unshift(window.chat[i]);
        tailCount++;
        i--;
      }
      while (i >= 0) {
        var msg = window.chat[i];
        var msgTokens = window.estimateTokens(msg.content);
        if (tail.reduce(function(s, m) { return s + window.estimateTokens(m.content); }, 0) + msgTokens > tailTokens) {
          break;
        }
        tail.unshift(msg);
        i--;
      }

      var regionEnd = window.chat.length - tail.length;
      if (regionEnd === 0) {
        return;
      }

      var start = window.chatSummary ? window.chatSummary.upTo : 0;
      var transcript = '';
      if (window.chatSummary) {
        transcript += 'PREVIOUS SUMMARY:\n' + window.chatSummary.text + '\n\n';
      }
      for (var j = start; j < regionEnd; j++) {
        transcript += window.chat[j].role + ': ' + window.chat[j].content + '\n';
      }

      var summary;
      if (window.estimateTokens(transcript) <= maxChunk) {
        summary = await window.summarizeText(transcript, 'You are a compaction engine. Summarize this conversation transcript for an agent that will continue it. Preserve with maximum recall: the users goals, every decision made, every fact or file name mentioned, tool results that matter, and all open questions. Discard filler. Output only the summary.');
      } else {
        // greedy chunking
        var chunks = [];
        var current = '';
        var lines = transcript.split('\n');
        for (var k = 0; k < lines.length; k++) {
          var line = lines[k] + '\n';
          if (window.estimateTokens(current + line) > maxChunk && current) {
            chunks.push(current);
            current = line;
          } else {
            current += line;
          }
        }
        if (current) chunks.push(current);

        var partials = [];
        for (var c = 0; c < chunks.length; c++) {
          var p = await window.summarizeText(chunks[c], 'You are a compaction engine. Summarize this conversation transcript for an agent that will continue it. Preserve with maximum recall: the users goals, every decision made, every fact or file name mentioned, tool results that matter, and all open questions. Discard filler. Output only the summary.');
          partials.push(p);
        }

        // reduce
        var joined = partials.join('\n');
        while (window.estimateTokens(joined) > maxChunk) {
          var subChunks = [];
          var cur = '';
          var jLines = joined.split('\n');
          for (var l = 0; l < jLines.length; l++) {
            var lLine = jLines[l] + '\n';
            if (window.estimateTokens(cur + lLine) > maxChunk && cur) {
              subChunks.push(cur);
              cur = lLine;
            } else {
              cur += lLine;
            }
          }
          if (cur) subChunks.push(cur);
          var newPartials = [];
          for (var s = 0; s < subChunks.length; s++) {
            var sp = await window.summarizeText(subChunks[s], 'You are a compaction engine. Summarize this conversation transcript for an agent that will continue it. Preserve with maximum recall: the users goals, every decision made, every fact or file name mentioned, tool results that matter, and all open questions. Discard filler. Output only the summary.');
            newPartials.push(sp);
          }
          joined = newPartials.join('\n');
        }
        summary = await window.summarizeText(joined, 'Merge these partial summaries into one cohesive summary. Preserve decisions, TODOs, open questions, file names, and constraints. Output only the summary.');
      }

      window.chatSummary = { text: summary, upTo: regionEnd };
      window.chatEvents.emit('compact', start + '-' + window.chatSummary.upTo + ' messages summarized into ' + window.estimateTokens(summary) + ' tokens');
    } catch (err) {
      window.chatEvents.emit('error', err.message);
    }
  };

  window.fetchAI = async function(systemPrompt) {
    var capacity = parseInt(document.getElementById('compact-threshold').value) || 500000;
    var totalTokens = window.estimateTokens(systemPrompt);
    for (var i = 0; i < window.chat.length; i++) {
      totalTokens += window.estimateTokens(window.chat[i].content);
    }

    if (totalTokens > capacity * 0.8) {
      window.chatEvents.emit('status', 'compacting...');
      await window.compactChat();
    }

    var realChat;
    var swapped = false;
    if (window.chatSummary) {
      realChat = window.chat;
      window.chat = [{ role: 'system', content: '<summary of earlier conversation>\n' + window.chatSummary.text + '\n</summary>' }].concat(realChat.slice(window.chatSummary.upTo));
      swapped = true;
    }

    var out = await prevFetchCompact(systemPrompt);

    if (swapped) {
      window.chat = realChat;
    }

    return out;
  };

  window.fetchAI._hasCompaction = true;
}
</script>

<script>
var agentIdBytes = new Uint8Array(8);
crypto.getRandomValues(agentIdBytes);
var agentId = '';
for (var i = 0; i < agentIdBytes.length; i++) {
  var hexByte = agentIdBytes[i].toString(16);
  if (hexByte.length === 1) hexByte = '0' + hexByte;
  agentId += hexByte;
}
window.agentId = agentId;

var planPath = 'memory#agents/' + window.agentId + '/plan';

var readPlan = async function() {
  var key = planPath.split('#')[1];
  return await read(key, 'memory');
};

var originalBuildAgentPrompt = window.buildAgentPrompt;
window.buildAgentPrompt = async function() {
  var prompt = await originalBuildAgentPrompt();
  var planContents = await readPlan();
  if (!planContents) planContents = 'empty';
  prompt += '\nCURRENT PLAN\npath: ' + planPath + '\ncontents: ' + planContents + '\nhow to plan: read the file skills/planning with the read tool\nREPLY FORMAT: end your reply with <<ACTION: name>> and the input on the next line, or <<ANSWER>> and your message on the next line';
  return prompt;
};
window.buildAgentPrompt._hasPlan = true;

var originalFetchAI = window.fetchAI;
var beatSeen = 0;
var beatPlanned = false;
window.fetchAI = async function(systemPrompt) {
  var userCount = 0;
  for (var i = 0; i < window.chat.length; i++) {
    if (window.chat[i].role === 'user') userCount++;
  }
  var diff = userCount - beatSeen;
  var fire = false;
  if (diff >= 3) {
    fire = true;
  } else if (diff >= 1) {
    var lastUserMsg = null;
    for (var j = window.chat.length - 1; j >= 0; j--) {
      if (window.chat[j].role === 'user') {
        lastUserMsg = window.chat[j].content;
        break;
      }
    }
    if (lastUserMsg && /error/i.test(lastUserMsg)) {
      fire = true;
    }
  }
  if (fire) {
    beatSeen = userCount;
    var reminderMsg;
    if (!beatPlanned) {
      reminderMsg = 'this task is running long — write your plan to the plan path in the system prompt now, one [ ] step per remaining action —';
      beatPlanned = true;
    } else {
      reminderMsg = 'Reminder: check your plan file (path in the system prompt), update it to match reality, then continue';
    }
    window.chat.push({ role: 'user', content: reminderMsg });
    try {
      return await originalFetchAI(systemPrompt);
    } finally {
      window.chat.pop();
    }
  } else {
    return await originalFetchAI(systemPrompt);
  }
};
window.fetchAI._hasHeartbeat = true;
</script>