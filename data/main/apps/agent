<script>
// all later scripts communicate ONLY through window.chatEvents and never touch the DOM directly
var handlers = {};
window.chatEvents = {
  on: function(name, fn) {
    if (!handlers[name]) handlers[name] = [];
    handlers[name].push(fn);
  },
  emit: function(name, payload) {
    var list = handlers[name];
    if (list) {
      for (var i = 0; i < list.length; i++) {
        try { list[i](payload); } catch (e) { console.error(e); }
      }
    }
  }
};
window.chatEvents.on('user', function(p){ console.log('user', p); });
window.chatEvents.on('delta', function(p){ console.log('delta', p); });
window.chatEvents.on('assistant', function(p){ console.log('assistant', p); });
window.chatEvents.on('tool_call', function(p){ console.log('tool_call', p); });
window.chatEvents.on('tool_result', function(p){ console.log('tool_result', p); });
window.chatEvents.on('compact', function(p){ console.log('compact', p); });
window.chatEvents.on('plan', function(p){ console.log('plan', p); });
window.chatEvents.on('status', function(p){ console.log('status', p); });
window.chatEvents.on('error', function(p){ console.log('error', p); });
window.chatEvents.on('done', function(p){ console.log('done', p); });
</script>

<script>
function nearBottom() {
  var el = document.getElementById('chat-messages');
  return el.scrollHeight - el.scrollTop - el.clientHeight < 40;
}

function appendMsg(cssClass, text) {
  var wasNearBottom = nearBottom();
  var el = document.getElementById('chat-messages');
  var div = document.createElement('div');
  div.className = 'msg ' + cssClass;
  div.appendChild(document.createTextNode(text));
  el.appendChild(div);
  if (wasNearBottom) {
    el.scrollTop = el.scrollHeight;
  }
  return div;
}

var streamDiv = null;

window.chatEvents.on('user', function(p) {
  appendMsg('user', p);
});

window.chatEvents.on('delta', function(p) {
  if (!streamDiv) {
    streamDiv = appendMsg('assistant', '');
  }
  streamDiv.appendChild(document.createTextNode(p));
  if (nearBottom()) {
    document.getElementById('chat-messages').scrollTop = document.getElementById('chat-messages').scrollHeight;
  }
});

window.chatEvents.on('assistant', function(p) {
  if (!streamDiv) {
    appendMsg('assistant', p);
  }
  streamDiv = null;
});

window.chatEvents.on('tool_call', function(p) {
  appendMsg('tool', 'tool call: ' + p);
});

window.chatEvents.on('tool_result', function(p) {
  appendMsg('tool', 'result: ' + p);
});

window.chatEvents.on('compact', function(p) {
  appendMsg('marker', '--- context compacted: ' + p + ' ---');
});

window.chatEvents.on('plan', function(p) {
  appendMsg('marker', 'plan: ' + p);
});

window.chatEvents.on('error', function(p) {
  appendMsg('error', String(p));
});

window.chatEvents.on('status', function(p) {
  document.getElementById('status-bar').innerText = String(p);
});
</script>

<script>
window.fetchAI = async function(systemPrompt) {
  var model = document.getElementById('model-name').value;
  var host = document.getElementById('model-host').value;
  var apikey = document.getElementById('api-key').value;
  localStorage.setItem('m', model);
  localStorage.setItem('h', host);
  localStorage.setItem('k', apikey);

  var messages = [{ role: 'system', content: systemPrompt }].concat(window.chat);
  window.abortCtrl = new AbortController();
  var headers = { 'Content-Type': 'application/json' };
  if (apikey) {
    headers.Authorization = 'Bearer ' + apikey;
  }
  var fullText = '';
  try {
    var response = await fetch(host, {
      method: 'POST',
      headers: headers,
      body: JSON.stringify({ model: model, messages: messages, stream: true }),
      signal: window.abortCtrl.signal
    });
    if (!response.ok) {
      window.chatEvents.emit('error', 'HTTP ' + response.status);
      return '';
    }
    var reader = response.body.getReader();
    var decoder = new TextDecoder();
    var buffer = '';
    while (true) {
      var result = await reader.read();
      if (result.done) break;
      buffer += decoder.decode(result.value, { stream: true });
      var lines = buffer.split('\n');
      buffer = lines.pop();
      for (var i = 0; i < lines.length; i++) {
        var line = lines[i].trim();
        if (line.startsWith('data: ')) {
          var data = line.slice(6);
          if (data === '[DONE]') continue;
          try {
            var json = JSON.parse(data);
            var content = json.choices && json.choices[0] && json.choices[0].delta && json.choices[0].delta.content;
            if (content) {
              fullText += content;
              window.chatEvents.emit('delta', content);
            }
          } catch (e) {
            // ignore parse errors
          }
        }
      }
    }
    return fullText;
  } catch (err) {
    if (err.name === 'AbortError') {
      window.chatEvents.emit('status', 'stopped');
    } else {
      window.chatEvents.emit('error', err.message);
    }
    return fullText;
  }
};

window.sendChat = async function(text) {
  window.chat.push({ role: 'user', content: text });
  window.chatEvents.emit('user', text);
  var systemFile = document.getElementById('system-file').value;
  var systemPrompt;
  if (systemFile) {
    systemPrompt = await read(systemFile);
  }
  if (!systemPrompt) {
    systemPrompt = localStorage.getItem('s') || 'You are a helpful assistant.';
  }
  window.chatEvents.emit('status', 'thinking...');
  var reply = await window.fetchAI(systemPrompt);
  window.chat.push({ role: 'assistant', content: reply });
  window.chatEvents.emit('assistant', reply);
  window.chatEvents.emit('status', 'idle');
  window.chatEvents.emit('done', reply);
};

document.getElementById('submit-btn').addEventListener('click', function() {
  var input = document.getElementById('user-input');
  var text = input.value.trim();
  if (text) {
    window.sendChat(text);
    input.value = '';
  }
});

document.getElementById('user-input').addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') {
    var input = document.getElementById('user-input');
    var text = input.value.trim();
    if (text) {
      window.sendChat(text);
      input.value = '';
    }
  }
});

document.getElementById('stop-btn').addEventListener('click', function() {
  window.stopAgent = true;
  if (window.abortCtrl) {
    window.abortCtrl.abort();
  }
});
</script>

<script>
window.parseAction = function(text) {
  var m = /<<ACTION:\s*([^>]+)>>\n([\s\S]*?)(?=<<|$)/.exec(text);
  if (!m) return null;
  return { name: m[1].trim(), input: m[2].trim() };
};

window.parseAnswer = function(text) {
  var m = /<<ANSWER>>\n([\s\S]*?)(?=<<|$)/.exec(text);
  if (!m) return null;
  return m[1];
};

window.buildAgentPrompt = async function() {
  var sf = document.getElementById('system-file').value;
  var base = (sf ? await read(sf) : null) || localStorage.getItem('s') || 'You are a helpful assistant.';
  var tools = window.getActiveToolsString ? await window.getActiveToolsString() : 'NO TOOLS AVAILABLE, ANSWER DIRECTLY';
  var mem = '';
  var keys = Object.keys(window.agentScratchpad);
  if (keys.length) {
    for (var i = 0; i < keys.length; i++) {
      mem += 'MEMORY POINTER ' + (i+1) + ' [' + keys[i] + ']: ' + window.agentScratchpad[keys[i]] + '\n';
    }
  } else {
    mem = '[Empty]';
  }
  return base + '\n\n' +
    'OUTPUT FORMAT: Every reply MUST end with exactly one tag. To use a tool output <<ACTION: tool_name>> then the input on the next line. To finish output <<ANSWER>> then the final message on the next line. NEVER use XML or <tool_call> tags. NEVER narrate tool use in plain prose. The <<ACTION>> tag is the only way a tool runs. A reply with no tag is a format error.\n\n' +
    'EXAMPLE:\n<<ANSWER>>\nThe task is complete.\n\n' +
    'AVAILABLE TOOLS:\n' + tools + '\n\n' +
    'CURRENT PLAN:\n' + window.agentPlan + '\n\n' +
    'WORKING MEMORY:\n' + mem;
};

window.runAgent = async function(userMessage) {
  window.chat.push({ role: 'user', content: userMessage });
  window.chatEvents.emit('user', userMessage);
  var errorCount = 0;
  var formatFails = 0;
  while (true) {
    try {
      var systemPrompt = await window.buildAgentPrompt();
      if (window.stopAgent) {
        systemPrompt += '\nUSER OVERRIDE: Stop executing tools. Output <<ANSWER>>.';
        window.stopAgent = false;
      }
      window.chatEvents.emit('status', 'thinking...');
      var aiResponse = await window.fetchAI(systemPrompt);
      window.chatEvents.emit('assistant', aiResponse);
      window.chat.push({ role: 'assistant', content: aiResponse });
      window.chatEvents.emit('status', 'idle');
      var action = window.parseAction(aiResponse);
      if (action && window.executeTool) {
        formatFails = 0;
        window.chatEvents.emit('tool_call', action.name);
        var result = await window.executeTool(action.name, action.input);
        window.chatEvents.emit('tool_result', result);
        window.chat.push({ role: 'user', content: 'OBSERVATION:\n' + result });
        continue;
      }
      if (action && !window.executeTool) {
        window.chat.push({ role: 'user', content: 'SYSTEM WARNING: no tool executor installed. Answer directly with <<ANSWER>>.' });
        continue;
      }
      var answer = window.parseAnswer(aiResponse);
      if (answer !== null) {
        window.chatEvents.emit('done', answer);
        break;
      }
      formatFails++;
      if (formatFails >= 3) {
        window.chatEvents.emit('error', 'model failed the output format 3 times');
        window.chatEvents.emit('done', aiResponse);
        break;
      }
      window.chat.push({ role: 'user', content: 'SYSTEM WARNING: format error. Your previous reply had no tag. Reply again and your reply MUST end with <<ACTION: name>> or <<ANSWER>>.' });
    } catch (err) {
      errorCount++;
      window.chatEvents.emit('error', err.message);
      if (errorCount >= 7) break;
    }
  }
};

var submitBtn = document.getElementById('submit-btn');
var stopBtn = document.getElementById('stop-btn');
var userInput = document.getElementById('user-input');
submitBtn.replaceWith(submitBtn.cloneNode(true));
stopBtn.replaceWith(stopBtn.cloneNode(true));
