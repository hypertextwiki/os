<script>
window.fetchImageModels = async function() {
  try {
    var hostInputEl = document.getElementById('model-host');
    var apiKeyInputEl = document.getElementById('api-key');
    var statusEl = document.getElementById('status-bar');
    var host = hostInputEl.value;
    var apiKey = apiKeyInputEl.value;
    statusEl.innerText = 'loading models...';
    var url = host + '/models';
    var headers = {};
    if (apiKey && apiKey.length > 0) {
      headers['Authorization'] = 'Bearer ' + apiKey;
    }
    var response = await fetch(url, { method: 'GET', headers: headers });
    if (!response.ok) {
      statusEl.innerText = 'HTTP ' + response.status;
      return;
    }
    var json = await response.json();
    var data = json.data;
    window.imgModels = data;
    var select = document.getElementById('model-select');
    while (select.firstChild) {
      select.removeChild(select.firstChild);
    }
    var saved = localStorage.getItem('apps_img_m');
    var found = false;
    for (var i = 0; i < data.length; i++) {
      var model = data[i];
      var option = document.createElement('option');
      option.value = model.id;
      option.textContent = model.name || model.id;
      select.appendChild(option);
      if (saved && saved === model.id) {
        found = true;
      }
    }
    if (found) {
      select.value = saved;
    } else if (select.children.length > 0) {
      select.children[0].selected = true;
    }
    statusEl.innerText = 'idle';
  } catch (err) {
    document.getElementById('status-bar').innerText = err.message;
  }
};

var hostInput = document.getElementById('model-host');
var keyInput = document.getElementById('api-key');
hostInput.addEventListener('change', window.fetchImageModels);
keyInput.addEventListener('change', window.fetchImageModels);

window.fetchImageModels();
</script>

<script>
window.imgParams = {};
window.renderImgParams = function() {
  if (!window.imgModels || window.imgModels.length === 0) return;
  var selectEl = document.getElementById('model-select');
  var selectedId = selectEl.value;
  var model = null;
  for (var i = 0; i < window.imgModels.length; i++) {
    if (window.imgModels[i].id === selectedId) {
      model = window.imgModels[i];
      break;
    }
  }
  if (!model) return;
  var supported = model.supported_parameters;
  if (!supported) return;
  for (var key in window.imgParams) {
    delete window.imgParams[key];
  }
  var container = document.getElementById('img-params');
  while (container.firstChild) {
    container.removeChild(container.firstChild);
  }
  for (var k in supported) {
    if (k === 'stream' || k === 'input_references') continue;
    var desc = supported[k];
    if (desc.type === 'enum') {
      var label = document.createElement('label');
      label.textContent = k;
      var sel = document.createElement('select');
      var vals = desc.values;
      for (var v = 0; v < vals.length; v++) {
        var opt = document.createElement('option');
        opt.value = vals[v];
        opt.textContent = vals[v];
        sel.appendChild(opt);
      }
      sel.value = vals[0];
      window.imgParams[k] = vals[0];
      sel.addEventListener('change', (function(key, sel) {
        return function() {
          window.imgParams[key] = sel.value;
        };
      })(k, sel));
      container.appendChild(label);
      container.appendChild(sel);
    } else if (desc.type === 'range') {
      var label2 = document.createElement('label');
      label2.textContent = k;
      var num = document.createElement('input');
      num.type = 'number';
      num.min = desc.min;
      num.max = desc.max;
      num.value = desc.min;
      window.imgParams[k] = desc.min;
      num.addEventListener('change', (function(key, num) {
        return function() {
          window.imgParams[key] = parseFloat(num.value);
        };
      })(k, num));
      container.appendChild(label2);
      container.appendChild(num);
    } else if (k === 'seed') {
      var label3 = document.createElement('label');
      label3.textContent = 'seed';
      var seedInput = document.createElement('input');
      seedInput.type = 'number';
      seedInput.placeholder = 'optional';
      seedInput.addEventListener('change', function() {
        if (seedInput.value === '') {
          delete window.imgParams.seed;
        } else {
          window.imgParams.seed = parseFloat(seedInput.value);
        }
      });
      container.appendChild(label3);
      container.appendChild(seedInput);
    }
  }
};

var modelSelectEl = document.getElementById('model-select');
modelSelectEl.addEventListener('change', window.renderImgParams);

var prevFetchModelsParams;
if (!window.fetchImageModels._hasParams) {
  prevFetchModelsParams = window.fetchImageModels;
  window.fetchImageModels = async function() {
    await prevFetchModelsParams();
    window.renderImgParams();
  };
  window.fetchImageModels._hasParams = true;
}
window.fetchImageModels();
</script>

<script>
window.generateImage = async function() {
  try {
    if (window.imgState.busy) return;
    var promptInput = document.getElementById('img-prompt');
    var prompt = promptInput.value.trim();
    if (prompt === '') {
      document.getElementById('status-bar').innerText = 'enter a prompt';
      return;
    }
    var negInput = document.getElementById('img-negative');
    var neg = negInput.value.trim();
    if (neg !== '') {
      prompt = prompt + '\nAvoid: ' + neg;
    }
    var modelSelect = document.getElementById('model-select');
    var model = modelSelect.value;
    var hostInput = document.getElementById('model-host');
    var host = hostInput.value;
    var apiKeyInput = document.getElementById('api-key');
    var apiKey = apiKeyInput.value;

    window.imgState.busy = true;
    document.getElementById('status-bar').innerText = 'generating...';
    window.abortCtrl = new AbortController();

    var body = { model: model, prompt: prompt };
    for (var key in window.imgParams) {
      if (window.imgParams.hasOwnProperty(key)) {
        var val = window.imgParams[key];
        if (val !== undefined && val !== null && val !== '') {
          body[key] = val;
        }
      }
    }

    var headers = { 'Content-Type': 'application/json' };
    if (apiKey && apiKey.length > 0) {
      headers['Authorization'] = 'Bearer ' + apiKey;
    }

    var response = await fetch(host, {
      method: 'POST',
      headers: headers,
      signal: window.abortCtrl.signal,
      body: JSON.stringify(body)
    });

    if (!response.ok) {
      document.getElementById('status-bar').innerText = 'HTTP ' + response.status;
      window.imgState.busy = false;
      return;
    }

    var json = await response.json();
    var data = json.data;
    for (var i = 0; i < data.length; i++) {
      var item = data[i];
      window.imgState.results.push({
        b64: item.b64_json,
        media_type: item.media_type || 'image/png',
        prompt: prompt,
        ts: Date.now()
      });
    }

    if (typeof window.renderGallery === 'function') {
      window.renderGallery();
    }

    window.imgState.busy = false;
    window.abortCtrl = null;
    document.getElementById('status-bar').innerText = 'idle';
  } catch (err) {
    if (err.name === 'AbortError') {
      document.getElementById('status-bar').innerText = 'stopped';
    } else {
      document.getElementById('status-bar').innerText = err.message;
    }
    window.imgState.busy = false;
    window.abortCtrl = null;
  }
};
</script>

<script>
window.renderGallery = function() {
  var gallery = document.getElementById('img-gallery');
  while (gallery.firstChild) {
    gallery.removeChild(gallery.firstChild);
  }
  for (var i = 0; i < window.imgState.results.length; i++) {
    var entry = window.imgState.results[i];
    var container = document.createElement('div');
    container.className = 'img-result';
    var img = document.createElement('img');
    img.src = 'data:' + entry.media_type + ';base64,' + entry.b64;
    container.appendChild(img);
    gallery.appendChild(container);
  }
};

var submitBtn = document.getElementById('submit-btn');
submitBtn.addEventListener('click', function() {
  window.generateImage();
});

var promptInput = document.getElementById('img-prompt');
promptInput.addEventListener('keydown', function(e) {
  if (e.ctrlKey && e.key === 'Enter') {
    window.generateImage();
  }
});

var stopBtn = document.getElementById('stop-btn');
stopBtn.addEventListener('click', function() {
  if (window.abortCtrl) {
    window.abortCtrl.abort();
  }
});

// future features hook the img:result event on window instead of wrapping this chain
var prevGenEvents = window.generateImage;
if (!window.generateImage._hasEvents) {
  window.generateImage = async function() {
    var before = window.imgState.results.length;
    await prevGenEvents();
    for (var i = before; i < window.imgState.results.length; i++) {
      var entry = window.imgState.results[i];
      window.dispatchEvent(new CustomEvent('img:result', { detail: entry }));
    }
  };
  window.generateImage._hasEvents = true;
}
</script>

