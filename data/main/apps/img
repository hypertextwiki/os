<script>
window.imgViewerIndex = null;

// create viewer DOM
var viewer = document.createElement('div');
viewer.id = 'img-viewer';
viewer.style.position = 'fixed';
viewer.style.top = '0';
viewer.style.left = '0';
viewer.style.width = '100%';
viewer.style.height = '100%';
viewer.style.background = 'rgba(0,0,0,0.5)';
viewer.style.display = 'none';
viewer.style.justifyContent = 'center';
viewer.style.alignItems = 'center';
viewer.style.zIndex = '9999';
viewer.style.flexDirection = 'row';

var prevBtn = document.createElement('button');
prevBtn.id = 'img-viewer-prev';
prevBtn.textContent = '⬅️';
prevBtn.style.padding = '16px';
prevBtn.style.fontSize = '24px';
prevBtn.style.cursor = 'pointer';

var column = document.createElement('div');
column.style.display = 'flex';
column.style.flexDirection = 'column';
column.style.alignItems = 'center';

var img = document.createElement('img');
img.id = 'img-viewer-img';
img.style.maxWidth = '80vw';
img.style.maxHeight = '80vh';

var caption = document.createElement('div');
caption.id = 'img-viewer-caption';
caption.style.color = '#fff';
caption.style.maxHeight = '3em';
caption.style.overflow = 'hidden';
caption.style.textAlign = 'center';
caption.style.padding = '8px';

column.appendChild(img);
column.appendChild(caption);

var nextBtn = document.createElement('button');
nextBtn.id = 'img-viewer-next';
nextBtn.textContent = '➡️';
nextBtn.style.padding = '16px';
nextBtn.style.fontSize = '24px';
nextBtn.style.cursor = 'pointer';

var closeBtn = document.createElement('button');
closeBtn.id = 'img-viewer-close';
closeBtn.textContent = '❌';
closeBtn.style.position = 'absolute';
closeBtn.style.top = '10px';
closeBtn.style.right = '10px';
closeBtn.style.padding = '16px';
closeBtn.style.fontSize = '24px';
closeBtn.style.cursor = 'pointer';
closeBtn.style.background = 'transparent';
closeBtn.style.border = 'none';
closeBtn.style.color = '#fff';

viewer.appendChild(prevBtn);
viewer.appendChild(column);
viewer.appendChild(nextBtn);
viewer.appendChild(closeBtn);

document.body.appendChild(viewer);

// the viewer reads window.imgState.results live on every render so navigation always reflects the current gallery

window.renderImgViewer = function() {
  if (window.imgViewerIndex === null) {
    viewer.style.display = 'none';
    return;
  }
  var results = window.imgState.results;
  if (results.length === 0) {
    window.closeImgViewer();
    return;
  }
  if (window.imgViewerIndex < 0) {
    window.imgViewerIndex = 0;
  }
  if (window.imgViewerIndex >= results.length) {
    window.imgViewerIndex = results.length - 1;
  }
  var entry = results[window.imgViewerIndex];
  img.src = 'data:' + entry.media_type + ';base64,' + entry.b64;
  caption.innerText = entry.model + ' — ' + entry.prompt;
  viewer.style.display = 'flex';
};

window.openImgViewer = function(i) {
  window.imgViewerIndex = i;
  viewer.style.display = 'flex';
  window.renderImgViewer();
  window.dispatchEvent(new CustomEvent('img:view', { detail: { index: i } }));
};

window.closeImgViewer = function() {
  window.imgViewerIndex = null;
  viewer.style.display = 'none';
};

window.stepImgViewer = function(d) {
  var n = window.imgState.results.length;
  if (n === 0) return;
  window.imgViewerIndex = (window.imgViewerIndex + d + n) % n;
  window.renderImgViewer();
};

var gallery = document.getElementById('img-gallery');
gallery.addEventListener('click', function(e) {
  var target = e.target;
  if (target.tagName === 'IMG' && target.closest) {
    var resultEl = target.closest('.img-result');
    if (resultEl) {
      var children = gallery.children;
      for (var i = 0; i < children.length; i++) {
        if (children[i] === resultEl) {
          window.openImgViewer(i);
          break;
        }
      }
    }
  }
});

viewer.addEventListener('click', function(e) {
  if (e.target === viewer) {
    window.closeImgViewer();
  }
});

prevBtn.addEventListener('click', function() {
  window.stepImgViewer(-1);
});

nextBtn.addEventListener('click', function() {
  window.stepImgViewer(1);
});

closeBtn.addEventListener('click', function() {
  window.closeImgViewer();
});

window.addEventListener('keydown', function(e) {
  if (window.imgViewerIndex === null) return;
  if (e.key === 'Escape') {
    window.closeImgViewer();
  } else if (e.key === 'ArrowLeft') {
    window.stepImgViewer(-1);
  } else if (e.key === 'ArrowRight') {
    window.stepImgViewer(1);
  }
});
</script>

<script>
window.EMPTY_PIXEL = "data:image/jpeg;base64,/9j/4AAQSkZJRgABAQEASABIAAD/2wBDAP//////////////////////////////////////////////////////////////////////////////////////wgALCAABAAEBAREA/8QAFBABAAAAAAAAAAAAAAAAAAAAAP/aAAgBAQABPxA=";
window.b64ToBlob = async function(b64, mime) {
  var response = await fetch('data:' + mime + ';base64,' + b64);
  return await response.blob();
};
window.emptyPixelBlob = async function() {
  var response = await fetch(window.EMPTY_PIXEL);
  return await response.blob();
};
window.embedMeta = async function(blob, entry) {
  var metadataText = entry.prompt + '\nModel: ' + entry.model + ', Date: ' + new Date(entry.ts).toISOString();
  var bmp = await createImageBitmap(blob);
  var canvas = document.createElement('canvas');
  canvas.width = bmp.width;
  canvas.height = bmp.height;
  var ctx = canvas.getContext('2d');
  ctx.drawImage(bmp, 0, 0);
  var jpeg = await new Promise(function(resolve, reject) {
    canvas.toBlob(function(blob) {
      if (blob) resolve(blob);
      else reject(new Error('toBlob failed'));
    }, 'image/jpeg', 0.92);
  });
  var jpegBytes = await jpeg.arrayBuffer();
  var jpegView = new Uint8Array(jpegBytes);
  var encoder = new TextEncoder();
  var textBytes = encoder.encode(metadataText);
  if (textBytes.length > 65533) {
    textBytes = textBytes.slice(0, 65533);
  }
  var seg = new Uint8Array(4 + textBytes.length);
  seg[0] = 0xFF;
  seg[1] = 0xFE;
  var len = textBytes.length + 2;
  seg[2] = (len >> 8) & 0xFF;
  seg[3] = len & 0xFF;
  seg.set(textBytes, 4);
  var newBytes = new Uint8Array(2 + seg.length + (jpegView.length - 2));
  newBytes.set(jpegView.subarray(0, 2), 0);
  newBytes.set(seg, 2);
  newBytes.set(jpegView.subarray(2), 2 + seg.length);
  return new Blob([newBytes], { type: 'image/jpeg' });
};
window.fileNameFor = function(entry) {
  var d = new Date(entry.ts);
  var year = String(d.getFullYear()).slice(-2);
  var month = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  var hours = String(d.getHours()).padStart(2, '0');
  var minutes = String(d.getMinutes()).padStart(2, '0');
  var seconds = String(d.getSeconds()).padStart(2, '0');
  var dateStr = year + month + day + '-' + hours + minutes + seconds;
  var words = entry.prompt.trim().split(/\s+/).slice(0, 10).map(function(w) {
    return w.toLowerCase().replace(/[^a-z0-9]/g, '');
  }).join('-');
  if (words === '') words = 'prompt';
  return dateStr + '-' + words + '.jpg';
};
window.saveTarget = function(folderString, filename) {
  var hashIndex = folderString.indexOf('#');
  var ns, folder;
  if (hashIndex !== -1) {
    ns = folderString.substring(0, hashIndex);
    folder = folderString.substring(hashIndex + 1);
  } else {
    ns = null;
    folder = folderString;
  }
  return { ns: ns, key: folder + '/' + filename };
};
</script>

