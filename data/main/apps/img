window.applyImageRecipe = function(entry) {
  var promptEl = document.getElementById('img-prompt');
  promptEl.value = entry.prompt;
  promptEl.dispatchEvent(new Event('change'));
  var selectEl = document.getElementById('model-select');
  var found = false;
  for (var i = 0; i < selectEl.options.length; i++) {
    if (selectEl.options[i].value === entry.model) {
      selectEl.value = entry.model;
      selectEl.dispatchEvent(new Event('change'));
      found = true;
      break;
    }
  }
};

var gallery = document.getElementById('img-gallery');
gallery.addEventListener('click', function(e) {
  var target = e.target;
  if (target.tagName === 'IMG' && target.closest) {
    var resultEl = target.closest('.img-result');
    if (resultEl) {
      var children = gallery.children;
      for (var i = 0; i < children.length; i++) {
        if (children[i] === resultEl) {
          var entry = window.imgState.results[i];
          if (entry) {
            window.applyImageRecipe(entry);
          }
          break;
        }
      }
    }
  }
});
