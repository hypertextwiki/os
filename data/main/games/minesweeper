<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  :root {
    --cell: 24px;
  }

  #A {
    width: 100vw;
    height: 100vh;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #c0c0c0;
    overflow: hidden;
  }

  #ms-panel {
    background: #c0c0c0;
    border: 3px solid;
    border-color: #dfdfdf #7b7b7b #7b7b7b #dfdfdf;
    box-shadow: inset 1px 1px 0 0 #ffffff, inset -1px -1px 0 0 #000000;
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-family: Tahoma, "Segoe UI", "MS Sans Serif", Geneva, sans-serif;
    font-size: 13px;
  }

  #ms-difficulty {
    display: flex;
    gap: 6px;
  }

  .ms-btn {
    background: #c0c0c0;
    border: 3px solid;
    border-color: #dfdfdf #7b7b7b #7b7b7b #dfdfdf;
    box-shadow: inset 1px 1px 0 0 #ffffff, inset -1px -1px 0 0 #000000;
    padding: 4px 10px;
    font-family: inherit;
    font-size: inherit;
    line-height: 1;
  }

  .ms-btn.active,
  .ms-btn:active {
    border-color: #7b7b7b #dfdfdf #dfdfdf #7b7b7b;
    box-shadow: inset 1px 1px 0 0 #000000, inset -1px -1px 0 0 #ffffff;
  }

  #ms-header {
    border: 3px solid;
    border-color: #7b7b7b #ffffff #ffffff #7b7b7b;
    box-shadow: inset 1px 1px 0 0 #000000, inset -1px -1px 0 0 #dfdfdf;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3px;
  }

  #ms-mines,
  #ms-time {
    background: #000000;
    color: #ff0000;
    font-family: monospace;
    font-weight: bold;
    font-size: 16px;
    padding: 2px 4px;
  }

  #ms-board {
    border: 3px solid;
    border-color: #7b7b7b #ffffff #ffffff #7b7b7b;
    box-shadow: inset 1px 1px 0 0 #000000, inset -1px -1px 0 0 #dfdfdf;
    display: grid;
    gap: 0;
    min-height: calc(var(--cell) * 9);
  }

  .ms-cell {
    width: var(--cell);
    height: var(--cell);
    background: #c0c0c0;
    border: 3px solid;
    border-color: #dfdfdf #7b7b7b #7b7b7b #dfdfdf;
    box-shadow: inset 1px 1px 0 0 #ffffff, inset -1px -1px 0 0 #000000;
    font-family: monospace;
    font-weight: bold;
    font-size: calc(var(--cell) * 0.6);
    line-height: 1;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    user-select: none;
  }

  .ms-cell.open {
    border: 1px solid #7b7b7b;
    box-shadow: none;
  }

  .ms-cell.mine {
    background: #ff0000;
  }

  .ms-cell.n1 { color: #0000ff; }
  .ms-cell.n2 { color: #008000; }
  .ms-cell.n3 { color: #ff0000; }
  .ms-cell.n4 { color: #000080; }
  .ms-cell.n5 { color: #800000; }
  .ms-cell.n6 { color: #008080; }
  .ms-cell.n7 { color: #000000; }
  .ms-cell.n8 { color: #7b7b7b; }
</style>

<div id="ms-panel">
  <div id="ms-difficulty">
    <button type="button" class="ms-btn active" data-diff="beginner">Beginner</button>
    <button type="button" class="ms-btn" data-diff="intermediate">Intermediate</button>
    <button type="button" class="ms-btn" data-diff="expert">Expert</button>
  </div>

  <header id="ms-header">
    <div id="ms-mines">010</div>
    <button type="button" id="ms-reset" class="ms-btn">🙂</button>
    <div id="ms-time">000</div>
  </header>

  <div id="ms-board"></div>
</div><script>
  window.msDifficulties = {
    beginner: { rows: 9, cols: 9, mines: 10 },
    intermediate: { rows: 16, cols: 16, mines: 40 },
    expert: { rows: 16, cols: 30, mines: 99 }
  };

  window.msConfig = {
    difficulty: "beginner",
    rows: 9,
    cols: 9,
    mines: 10
  };

  var board = null;
  var gameOver = false;
  var gameWon = false;
  var firstClick = true;
  var flagCount = 0;
  var openCount = 0;
  var seconds = 0;
  var timerId = null;

  window.newGame = function () {
    clearInterval(window.timerId);
    window.timerId = null;
    window.gameOver = false;
    window.gameWon = false;
    window.firstClick = true;
    window.flagCount = 0;
    window.openCount = 0;
    window.seconds = 0;
    window.board = null;
    var minesLabel = String(window.msConfig.mines);
    while (minesLabel.length < 3) {
      minesLabel = "0" + minesLabel;
    }
    document.getElementById("ms-mines").innerText = minesLabel;
    document.getElementById("ms-time").innerText = "000";
    document.getElementById("ms-reset").innerText = "🙂";
    if (window.renderBoard) {
      window.renderBoard();
    }
    if (window.fitBoard) {
      window.fitBoard();
    }
  };
</script><script>
