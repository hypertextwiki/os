</script><script>
  window.buildBoard = function () {
    var grid = [];
    var row;
    var y;
    var x;
    for (y = 0; y < window.msConfig.rows; y++) {
      row = [];
      for (x = 0; x < window.msConfig.cols; x++) {
        row.push({ mine: false, open: false, flag: false, count: 0 });
      }
      grid.push(row);
    }
    window.board = grid;
  };

  window.renderBoard = function () {
    var boardEl = document.getElementById("ms-board");
    var cell;
    var y;
    var x;
    window.buildBoard();
    boardEl.style.gridTemplateColumns = "repeat(" + window.msConfig.cols + ", var(--cell))";
    boardEl.innerHTML = "";
    for (y = 0; y < window.msConfig.rows; y++) {
      for (x = 0; x < window.msConfig.cols; x++) {
        cell = document.createElement("button");
        cell.className = "ms-cell";
        cell.dataset.x = x;
        cell.dataset.y = y;
        cell.addEventListener("click", (function (cx, cy) {
          return function () {
            window.revealCell(cx, cy);
          };
        })(x, y));
        cell.addEventListener("contextmenu", (function (cx, cy) {
          return function (event) {
            event.preventDefault();
            window.toggleFlag(cx, cy);
          };
        })(x, y));
        boardEl.appendChild(cell);
      }
    }
  };
</script><script>
  window.placeMines = function (safeX, safeY) {
    var total = window.msConfig.rows * window.msConfig.cols;
    var safe = {};
    var candidates = [];
    var i;
    var j;
    var tmp;
    var idx;
    var dy;
    var dx;
    var ny;
    var nx;
    var y;
    var x;
    var cell;
    for (dy = -1; dy <= 1; dy++) {
      for (dx = -1; dx <= 1; dx++) {
        ny = safeY + dy;
        nx = safeX + dx;
        if (ny >= 0 && ny < window.msConfig.rows && nx >= 0 && nx < window.msConfig.cols) {
          safe[ny * window.msConfig.cols + nx] = true;
        }
      }
    }
    for (i = 0; i < total; i++) {
      if (!safe[i]) {
        candidates.push(i);
      }
    }
    for (i = candidates.length - 1; i > 0; i--) {
      j = Math.floor(Math.random() * (i + 1));
      tmp = candidates[i];
      candidates[i] = candidates[j];
      candidates[j] = tmp;
    }
    for (i = 0; i < window.msConfig.mines && i < candidates.length; i++) {
      idx = candidates[i];
      window.board[Math.floor(idx / window.msConfig.cols)][idx % window.msConfig.cols].mine = true;
    }
    for (y = 0; y < window.msConfig.rows; y++) {
      for (x = 0; x < window.msConfig.cols; x++) {
        cell = window.board[y][x];
        cell.count = 0;
        for (dy = -1; dy <= 1; dy++) {
          for (dx = -1; dx <= 1; dx++) {
            ny = y + dy;
            nx = x + dx;
            if (ny >= 0 && ny < window.msConfig.rows && nx >= 0 && nx < window.msConfig.cols) {
              if (window.board[ny][nx].mine) {
                cell.count = cell.count + 1;
              }
            }
          }
        }
      }
    }
  };

  window.revealCell = function (x, y) {
    var cell;
    var el;
    var dy;
    var dx;
    var ny;
    var nx;
    var ncell;
    if (window.gameOver || !window.board) {
      return;
    }
    cell = window.board[y][x];
    if (cell.open || cell.flag) {
      return;
    }
    if (window.firstClick) {
      window.placeMines(x, y);
      window.firstClick = false;
      window.timerId = window.setInterval(function () {
        var label;
        window.seconds = window.seconds + 1;
        if (window.seconds > 999) {
          window.seconds = 999;
        }
        label = String(window.seconds);
        while (label.length < 3) {
          label = "0" + label;
        }
        document.getElementById("ms-time").innerText = label;
      }, 1000);
    }
    if (cell.mine) {
      window.loseGame(x, y);
      return;
    }
    cell.open = true;
    window.openCount = window.openCount + 1;
    el = document.getElementById("ms-board").children[y * window.msConfig.cols + x];
    el.classList.add("open");
    if (cell.count > 0) {
      el.innerText = String(cell.count);
      el.classList.add("n" + cell.count);
    } else {
      for (dy = -1; dy <= 1; dy++) {
        for (dx = -1; dx <= 1; dx++) {
          if (dy === 0 && dx === 0) {
            continue;
          }
          ny = y + dy;
          nx = x + dx;
          if (ny < 0 || ny >= window.msConfig.rows || nx < 0 || nx >= window.msConfig.cols) {
            continue;
          }
          ncell = window.board[ny][nx];
          if (!ncell.open && !ncell.flag) {
            window.revealCell(nx, ny);
          }
        }
      }
    }
    window.checkWin();
  };

  window.toggleFlag = function (x, y) {
    var cell;
    var el;
    var remaining;
    var label;
    if (window.gameOver || !window.board) {
      return;
    }
    cell = window.board[y][x];
    if (cell.open) {
      return;
    }
    cell.flag = !cell.flag;
    el = document.getElementById("ms-board").children[y * window.msConfig.cols + x];
    if (cell.flag) {
      el.innerText = "🚩";
      window.flagCount = window.flagCount + 1;
    } else {
      el.innerText = "";
      window.flagCount = window.flagCount - 1;
    }
    remaining = window.msConfig.mines - window.flagCount;
    label = String(remaining);
    while (label.length < 3) {
      label = "0" + label;
    }
    document.getElementById("ms-mines").innerText = label;
  };

  window.checkWin = function () {
    var total = window.msConfig.rows * window.msConfig.cols;
    if (window.openCount === total - window.msConfig.mines) {
      window.gameOver = true;
      window.gameWon = true;
      window.clearInterval(window.timerId);
      window.timerId = null;
      document.getElementById("ms-reset").innerText = "😎";
    }
  };

  window.loseGame = function (x, y) {
    var boardEl = document.getElementById("ms-board");
    var yy;
    var xx;
    var cell;
    var el;
    window.gameOver = true;
    window.clearInterval(window.timerId);
    window.timerId = null;
    document.getElementById("ms-reset").innerText = "😵";
    for (yy = 0; yy < window.msConfig.rows; yy++) {
      for (xx = 0; xx < window.msConfig.cols; xx++) {
        cell = window.board[yy][xx];
        if (cell.mine) {
          el = boardEl.children[yy * window.msConfig.cols + xx];
          el.classList.add("open");
        }
      }
    }
    boardEl.children[y * window.msConfig.cols + x].classList.add("mine");
  };

  document.getElementById("ms-reset").addEventListener("click", function () {
    window.newGame();
  });
</script><script>
