</script><script>
  window.fitBoard = function () {
    var cellSize;
    var byWidth;
    var byHeight;
    byWidth = (window.innerWidth * 0.95) / window.msConfig.cols;
    byHeight = (window.innerHeight * 0.80) / window.msConfig.rows;
    cellSize = Math.floor(Math.min(byWidth, byHeight));
    if (cellSize < 8) {
      cellSize = 8;
    }
    document.documentElement.style.setProperty("--cell", cellSize + "px");
  };

  window.addEventListener("resize", function () {
    window.fitBoard();
  });

  window.fitBoard();
</script><script>
  var diffButtons = document.getElementById("ms-difficulty").getElementsByTagName("button");
  var i;
  var wireButton = function (btn) {
    btn.addEventListener("click", function () {
      var key = btn.getAttribute("data-diff");
      var preset = window.msDifficulties[key];
      var j;
      if (preset) {
        window.msConfig.difficulty = key;
        window.msConfig.rows = preset.rows;
        window.msConfig.cols = preset.cols;
        window.msConfig.mines = preset.mines;
      }
      for (j = 0; j < diffButtons.length; j++) {
        diffButtons[j].classList.remove("active");
      }
      btn.classList.add("active");
      window.newGame();
    });
  };
  for (i = 0; i < diffButtons.length; i++) {
    wireButton(diffButtons[i]);
  }
  window.newGame();
</script>