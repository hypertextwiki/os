

/* delete - permanently delete a file. INPUT: a bare file name like old.txt for the current namespace, or namespace#filename like oz#old.txt for another namespace */
try {
  let path = INPUT.trim();
  if (!path) return "Error: no file path provided";
  let hashIdx = path.indexOf('#');
  let namespace, filename;
  if (hashIdx !== -1) {
    namespace = path.slice(0, hashIdx);
    filename = path.slice(hashIdx + 1);
  } else {
    namespace = undefined;
    filename = path;
  }
  let dbHandle;
  if (namespace) {
    dbHandle = await getDB(namespace);
  } else {
    dbHandle = db;
  }
  let existing = await read(filename, namespace);
  if (!existing) return "Error: file not found: " + path;
  await queryDB(tx("readwrite", dbHandle).delete(filename));
  return "Deleted: " + path;
} catch (e) {
  return "Error: " + (e.message || e);
}