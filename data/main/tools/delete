

/* delete - permanently delete a file. INPUT: a bare file name like old.txt for the current namespace, or namespace#filename like oz#old.txt for another namespace */
try {
  let input = INPUT.trim();
  if (!input) return "Error: no file path provided";
  let hashIndex = input.indexOf("#");
  let ns, fname;
  if (hashIndex !== -1) {
    ns = input.slice(0, hashIndex);
    fname = input.slice(hashIndex + 1);
  } else {
    ns = undefined;
    fname = input;
  }
  let dbHandle = ns ? await getDB(ns) : db;
  let fileContent = await read(fname, dbHandle);
  if (fileContent === undefined || fileContent === null) {
    return `Error: file not found: ${input}`;
  }
  await queryDB(tx("readwrite", dbHandle).delete(fname));
  return `Deleted: ${input}`;
} catch (err) {
  return `Error: ${err.message || err}`;
}