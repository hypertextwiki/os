

/* list-files - list the names of files that exist so you can discover and choose files. INPUT: empty for all files in the current namespace, a prefix like apps/ to filter, oz# for all files in namespace oz, oz#apps/ for a prefix in namespace oz */
try {
  let input = INPUT.trim();
  let idx = input.indexOf('#');
  let ns, prefix;
  if (idx === -1) {
    ns = undefined;
    prefix = input;
  } else {
    ns = input.slice(0, idx);
    prefix = input.slice(idx + 1);
    if (ns === '') ns = undefined;
  }
  let dbHandle;
  if (ns !== undefined) {
    dbHandle = await getDB(ns);
  } else {
    dbHandle = await getDB();
  }
  let query;
  if (prefix === '') {
    query = undefined;
  } else {
    query = IDKeyRange.bound(prefix, prefix + '\uFFFF');
  }
  let resultKeys = await keys(query, dbHandle);
  if (!resultKeys || resultKeys.length === 0) {
    return `No files found: ${input}`;
  }
  resultKeys.sort();
  return resultKeys.join('\n');
} catch (e) {
  return `Error: ${e.message}`;
}