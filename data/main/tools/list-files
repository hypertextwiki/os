

/* list-files - list the names of files that exist so you can discover and choose files. INPUT: empty for all files in the current namespace, a prefix like apps/ to filter, oz# for all files in namespace oz, oz#apps/ for a prefix in namespace oz */
try {
  let input = INPUT.trim();
  let ns, prefix;
  if (input.includes('#')) {
    [ns, prefix] = input.split('#', 1);
  } else {
    ns = undefined;
    prefix = input;
  }
  let dbHandle;
  if (ns !== undefined) {
    dbHandle = await getDB(ns);
  } else {
    dbHandle = await getDB();
  }
  let query;
  if (prefix === '') {
    query = undefined;
  } else {
    query = IDBKeyRange.bound(prefix, prefix + '\uffff');
  }
  let keysList = await keys(query, dbHandle);
  if (!keysList || keysList.length === 0) {
    return "No files found: " + input;
  }
  keysList.sort();
  return keysList.join('\n');
} catch (e) {
  return "Error: " + e.message;
}