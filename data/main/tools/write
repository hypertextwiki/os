

/* write - create or overwrite a file. INPUT: the first line is the path, a bare name like todo.txt for the current namespace or namespace#filename like oz#todo.txt for another namespace, every line after the first line is the file content */
try {
  const lines = INPUT.split('\n');
  const path = lines[0].trim();
  if (!path) return 'Error: no file path provided';
  const content = lines.slice(1).join('\n');
  let namespace, filename;
  const hashIndex = path.indexOf('#');
  if (hashIndex !== -1) {
    namespace = path.substring(0, hashIndex) || undefined;
    filename = path.substring(hashIndex + 1);
  } else {
    namespace = undefined;
    filename = path;
  }
  await write(content, filename, namespace);
  return `Wrote ${content.length} characters and ${path}`;
} catch (e) {
  return `Error: ${e.message}`;
}