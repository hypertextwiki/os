{
  "name": "qrx",
  "main": "workers/cloudflare.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/read", "/write", "/data/*", "/stream"]
  },
  // No database_id: Wrangler auto-provisions "qrx" on first deploy.
  // D1 free tier: 5 GB storage, 5M rows read/day, 100k rows written/day —
  // hard-capped (never bills), no credit card required.
  // migrations_dir lives on the binding — this is where wrangler d1
  // migrations apply looks for the SQL files.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "qrx",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Public namespaces are served (cached) to anonymous visitors and baked
    // into assets at build time. Private namespaces are SYNC_KEY-only, never
    // baked, never cached. Unlisted = private by default for reads.
    "QRX_PUBLIC_NAMESPACES": "main,wiki,cache,reddit",
    "QRX_PRIVATE_NAMESPACES": "",
    // How long anonymous reads are remembered at the edge, in seconds.
    // Writes purge what they can; this TTL is the backstop for the edge
    // locations a purge can't reach. Lower = fresher for strangers,
    // higher = cheaper under load. Default: 1 day.
    "CACHE_TTL_SECONDS": "86400"
  }
}
